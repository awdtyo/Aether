# AETHER — Personal AI Operating System
# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=sqlite+aiosqlite:///./aether.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://aether:aether@db:5432/aether

AETHER_WORKSPACE=/tmp/aether_workspace
AETHER_GIT_ALLOWLIST=/tmp/aether_workspace

# Model provider: mock | openai_compatible
# - mock: local deterministic responses, offline dev/tests (default)
# - openai_compatible: OpenRouter, Nebius Token Factory, NVIDIA, Ollama, etc.
MODEL_PROVIDER=mock

# OpenRouter (OpenAI-compatible)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Provider-specific alias (used only if OPENAI_API_KEY is empty):
# OPENROUTER_API_KEY=

# NVIDIA Nemotron model (any OpenRouter model id works, no code changes):
MODEL_NAME=nvidia/nemotron-3.5-lightning
# Optional per-tier overrides (empty = use MODEL_NAME):
# MODEL_FAST=
# MODEL_STANDARD=
# MODEL_REASONING=
# MODEL_MULTIMODAL=

# Optional OpenRouter metadata headers (sent only when set)
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=AETHER

# Provider behavior (max tokens needs headroom: Nemotron reasoning tokens
# count toward the completion budget, so keep this generous)
# MODEL_TEMPERATURE=0.3
# MODEL_MAX_TOKENS=4096
# MODEL_TIMEOUT_S=60

# Nebius Token Factory alternative (set base URL + key, keep provider openai_compatible):
# OPENAI_BASE_URL=https://api.studio.nebius.com/v1
# NEBIUS_API_KEY=... (or place the token in OPENAI_API_KEY)

# Demo mode: deterministic sample memories/events/notes, no credentials needed
DEMO_MODE=false

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
