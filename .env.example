# AETHER — Personal AI Operating System
# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=sqlite+aiosqlite:///./aether.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://aether:aether@db:5432/aether

AETHER_WORKSPACE=/tmp/aether_workspace
AETHER_GIT_ALLOWLIST=/tmp/aether_workspace

# Model provider: mock | openai_compatible | nebius
MODEL_PROVIDER=mock
# OpenAI-compatible endpoint (works for Nebius Token Factory, NVIDIA, OpenAI, Ollama, etc.)
OPENAI_BASE_URL=https://api.studio.nebius.com/v1
OPENAI_API_KEY=
MODEL_FAST=nemotron-fast
MODEL_STANDARD=nemotron-standard
MODEL_REASONING=nemotron-reasoning
MODEL_MULTIMODAL=nemotron-multimodal

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
